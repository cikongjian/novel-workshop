# ============================================
# 安全配置（生产环境必须修改）
# ============================================

# AI 对话模型配置
# 供应商: anthropic / openai / deepseek / qwen / zhipu / moonshot / doubao / baichuan / stepfun / minimax / siliconflow
MODEL_PROVIDER=deepseek
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash
# 自定义 API 地址（留空使用供应商默认地址）
MODEL_BASE_URL=

# 是否启用模型流式输出（SSE）。默认 false（关闭）。
# 关闭后 Agent 改用一次性返回，兼容反向代理/网关对流式响应的缓冲；移动端不逐字显示进度，但生成更稳定。
# MODEL_STREAMING_ENABLED=false

# 文本向量化配置（用于记忆系统的语义搜索，可选）
# 支持 Embedding 的供应商：openai / ollama / qwen / zhipu / siliconflow
# 使用 Ollama 本地 Embedding 示例：
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_MODEL=nomic-embed-text
#   EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1

# 图像生成配置（用于 AI 封面候选和角色立绘）
# 第三方代理填写 OpenAI 兼容 /v1 地址；官方 OpenAI 直连可留空
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_BASE_URL=

# 服务器配置
PORT=3001
HOST=127.0.0.1

# CORS 白名单（逗号分隔，生产环境必须配置）
# 示例: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173

# 运行环境（development / production）
NODE_ENV=development

# 反向代理信任层级（Nginx 反代时设为 1，无反代时留空）
# TRUST_PROXY=1
# 服务器域名（用于 HTTPS 重定向，防止 Host Header 注入）
# SERVER_HOST=yourdomain.com

# /api/generate 独立限流（用于控制模型成本）
# 窗口毫秒（默认 60000）
GENERATE_RATE_LIMIT_WINDOW_MS=60000
# 每窗口每用户/IP最大请求数（默认 30）
GENERATE_RATE_LIMIT_MAX=30
# 每用户/IP最大并发生成请求数（默认 2，仅 POST）
GENERATE_MAX_CONCURRENT=2

# 数据存储目录
DATA_DIR=./data

# ============================================
# 支付配置（默认关闭）
# ============================================

# 支付回调后端地址与支付完成前端回跳地址
BILLING_PAYMENT_API_BASE_URL=http://127.0.0.1:3001
BILLING_PAYMENT_FRONTEND_BASE_URL=http://127.0.0.1:5173
# 订单超时分钟数
BILLING_PAYMENT_ORDER_EXPIRE_MINUTES=30
# 微信原生支付二维码生成服务。默认留空，仅返回 code_url 供客户端本地生成；
# 配置第三方服务会把支付二维码内容发送给该服务，请先完成隐私与合规评估。
BILLING_PAYMENT_QR_CODE_PROVIDER=

# 支付宝
BILLING_ALIPAY_ENABLED=false
BILLING_ALIPAY_APP_ID=
BILLING_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
BILLING_ALIPAY_PRIVATE_KEY=
BILLING_ALIPAY_PUBLIC_KEY=

# 微信支付
BILLING_WECHAT_ENABLED=false
BILLING_WECHAT_APP_ID=
BILLING_WECHAT_MCH_ID=
BILLING_WECHAT_GATEWAY_URL=https://api.mch.weixin.qq.com
BILLING_WECHAT_MERCHANT_SERIAL_NO=
BILLING_WECHAT_MERCHANT_PRIVATE_KEY=
BILLING_WECHAT_API_V3_KEY=
BILLING_WECHAT_PLATFORM_PUBLIC_KEY=
BILLING_WECHAT_PLATFORM_SERIAL_NO=
BILLING_WECHAT_H5_APP_NAME=Novel Workshop

# 服务端 TTS 访问范围（off / admin / on）。默认仅管理员可触发服务端合成与试听。
AUDIOBOOK_ACCESS_MODE=admin
# TTS 语音合成引擎（edge-tts / qwen3-tts）。edge-tts 使用非官方 Edge Read Aloud 端点，请先完成服务条款审查。
TTS_ENGINE=edge-tts
# Qwen3-TTS 本地服务地址（仅 TTS_ENGINE=qwen3-tts 时使用）
QWEN3_TTS_URL=http://127.0.0.1:8765
# 后端是否自动托管启动 Qwen3-TTS（仅在 TTS_ENGINE=qwen3-tts 时生效）
QWEN3_TTS_AUTO_START=true
# 启动 Qwen3-TTS 使用的 Python 命令（可改为 python3 或 venv 解释器绝对路径）
QWEN3_TTS_PYTHON=python
# Qwen3-TTS 启动脚本路径
QWEN3_TTS_SERVER_SCRIPT=./qwen-tts-server/server.py

# 混合模式旁白引擎（仅 TTS_ENGINE=qwen3-tts 时生效）
# edge-tts: 微软免费在线服务（可能被限速）
# kokoro: 本地 CPU 推理（82M 轻量模型，极快，不占 GPU）
TTS_NARRATION_ENGINE=edge-tts
# Hugging Face 镜像地址。默认留空使用官方源；需要镜像时请显式配置并自行评估供应链风险。
HF_ENDPOINT=

# === Qwen3-TTS GPU 推理优化（可选） ===
# TF32 矩阵运算加速（RTX 30xx/40xx/50xx 默认开启，速度提升 ~20%）
# QWEN_TTS_TF32=true
# cuDNN benchmark 自动选择最快算法（默认开启）
# QWEN_TTS_CUDNN_BENCH=true
# torch.compile 预编译（首次推理慢，后续更快；默认关闭，新卡可尝试）
# QWEN_TTS_COMPILE=false
# 分句合成阈值（字数，高于此值自动分句；默认50，越高=越少调用但单次越慢）
# QWEN_TTS_CHUNK_THRESHOLD=50
# 短句合并阈值（字数，低于此值合并到相邻句；默认12）
# QWEN_TTS_MERGE_SHORT=12

# === 主管线增强阈值（可选） ===
# 角色一致性门禁阈值（0-100）
CHARACTER_GUARDRAIL_MIN_CONFLICT_RATE=30
CHARACTER_GUARDRAIL_MIN_HUMANITY_RATE=45
CHARACTER_GUARDRAIL_MIN_STABILITY_SCORE=45

# 去模板化阈值
ANTI_TEMPLATE_REPEATED_OPENER_MIN_COUNT=2
ANTI_TEMPLATE_REPEATED_CLICHE_MIN_COUNT=3
# 回看最近多少章用于去模板分析（1-20）
ANTI_TEMPLATE_LOOKBACK_CHAPTERS=3

# AI 痕迹规避（负面清单）
ANTI_AI_TELLS_ENABLED=true
# “近期高频使用”触发阈值（合并回看章节统计，>= 即提示替换）
ANTI_AI_TELLS_REPEATED_MIN_COUNT=2
# 负面清单示例展示上限（0-60）
ANTI_AI_TELLS_MAX_EXAMPLES=18
# “近期高频使用”提示条目上限（0-30）
ANTI_AI_TELLS_MAX_FREQUENT_ITEMS=8

# 结构性 AI 痕迹规避（总结腔/条理腔）
ANTI_AI_STRUCTURE_ENABLED=true
# 转折连接词密度上限（每 1000 字）
ANTI_AI_STRUCTURE_TRANSITION_PER_1K_MAX=8
# “近期高频使用”触发阈值（合并回看章节统计，>= 即提示替换）
ANTI_AI_STRUCTURE_REPEATED_MIN_COUNT=2
# 负面清单示例展示上限（0-60）
ANTI_AI_STRUCTURE_MAX_EXAMPLES=16
# “近期高频使用”提示条目上限（0-30）
ANTI_AI_STRUCTURE_MAX_FREQUENT_ITEMS=8

# === 社区投票防刷参数（可选） ===
# 礼物票权重（默认 1.2）
COMMUNITY_GIFT_WEIGHT=1.2
# 单用户同章节投票冷却（毫秒，默认 2000）
COMMUNITY_VOTE_COOLDOWN_MS=2000
# 单用户同章节投票次数上限
COMMUNITY_VOTE_LIMIT_MAX_COUNT_PER_USER_PER_CHAPTER=80
# 单用户同章节免费票上限
COMMUNITY_VOTE_LIMIT_MAX_FREE_PER_USER_PER_CHAPTER=20
# 单用户同章节付费票积分上限
COMMUNITY_VOTE_LIMIT_MAX_PAID_POINTS_PER_USER_PER_CHAPTER=20000
# 单用户同章节礼物值上限
COMMUNITY_VOTE_LIMIT_MAX_GIFT_POINTS_PER_USER_PER_CHAPTER=50000
# 单用户同章节加权贡献值上限（免费票 + 付费票 + 礼物值 * 权重）
COMMUNITY_VOTE_LIMIT_MAX_WEIGHTED_SCORE_PER_USER_PER_CHAPTER=60000
# 速率桶窗口（毫秒）
COMMUNITY_VOTE_RATE_WINDOW_MS=60000
# 窗口内同 IP 最大投票请求数
COMMUNITY_VOTE_RATE_MAX_PER_IP=120
# 窗口内同 用户+UA 最大投票请求数
COMMUNITY_VOTE_RATE_MAX_PER_USER_UA=60

# === 签约管线预设总开关（默认关闭）===
# 启用后强制所有门禁升级为 strict 模式，开启自动修订循环，提高质量阈值
# 注意：strict 模式下每个门禁失败会额外调用编辑 Agent 修复，会显著增加生成耗时
# 建议仅在作品接近投稿/签约阶段时手动开启
SIGNING_PIPELINE_PRESET_ENABLED=false

# === 自动修订循环（默认关闭）===
# 启用后如果 Reader 评分低于阈值，会自动重跑 writer→editor→reader 循环
# AUTO_REVISION_ENABLED=false
# AUTO_REVISION_SCORE_THRESHOLD=7.2
# AUTO_REVISION_MAX_ROUNDS=3

# === 世界观驱动开关（阶段灰度） ===
# 是否启用世界观契约（默认关闭，关闭时保持旧行为）
WORLD_CONTRACT_ENABLED=false
# 世界观门禁模式：off / warn / strict（默认 warn，仅评估不触发修复循环）
WORLD_GATE_MODE=warn
# strict 失败后是否自动降级为 warn（默认 true，避免阻断入库）
WORLD_GATE_STRICT_FALLBACK_TO_WARN=true
# 是否启用世界观检索V2（Top-K混合检索）
WORLD_RETRIEVAL_V2_ENABLED=false
# 世界观检索返回条目数（4-30）
WORLD_RETRIEVAL_TOP_K=10

# OUTLINE gate mode: off / warn / strict
OUTLINE_GATE_MODE=warn
# Auto downgrade strict failures to warn
OUTLINE_GATE_STRICT_FALLBACK_TO_WARN=true
# Max required outline checkpoints per chapter (2-12)
OUTLINE_GATE_MAX_REQUIRED=6

# Quality gate mode: off / warn / strict
QUALITY_GATE_MODE=warn
# Auto downgrade strict failures to warn
QUALITY_GATE_STRICT_FALLBACK_TO_WARN=true
# Overall score threshold for strict mode (40-100)
QUALITY_GATE_PASS_SCORE=72
# Structure score threshold (30-100)
QUALITY_GATE_MIN_STRUCTURE_SCORE=60
# Style score threshold (30-100)
QUALITY_GATE_MIN_STYLE_SCORE=58
# Emotion score threshold (30-100)
QUALITY_GATE_MIN_EMOTION_SCORE=55
# Shadow mode: strict 仅观测不拦截（默认 false）
QUALITY_GATE_SHADOW_MODE=false
# 启用局部反 AI 纹理改写（默认 true）
QUALITY_GATE_ENABLE_LOCALIZED_ANTI_AI_REWRITE=true
# 局部改写最多处理窗口数（1-24）
QUALITY_GATE_LOCAL_REWRITE_MAX_WINDOWS=8
# 启用改写回归保护（默认 true）
QUALITY_GATE_ENABLE_REGRESSION_GUARD=true
# 启用“同段 AI 微动作扎堆”门禁（默认 true）
QUALITY_GATE_ENABLE_AI_TELL_CLUSTER_GATE=true
# 启用角色口吻锚点提示（默认 true）
QUALITY_GATE_ENABLE_VOICE_ANCHORS=true
# 启用开头/章末轮换缓存提示（默认 true）
QUALITY_GATE_ENABLE_PATTERN_ROTATION_CACHE=true
# 按题材自适应质量阈值（默认 true）
QUALITY_GATE_ENABLE_GENRE_ADAPTIVE_THRESHOLDS=true

# Continuity shadow mode: strict 仅观测不拦截（默认 false）
CONTINUITY_GATE_SHADOW_MODE=false
# 启用身份自称错位检查（默认 true）
CONTINUITY_GATE_ENABLE_IDENTITY_SELF_ADDRESS=true
# 启用身份他称错位检查（默认 true）
CONTINUITY_GATE_ENABLE_IDENTITY_ADDRESS=true

# Power rule gate mode: off / warn / strict
POWER_RULE_GATE_MODE=warn
# Auto downgrade strict failures to warn
POWER_RULE_GATE_STRICT_FALLBACK_TO_WARN=true

# === 超长篇模式 ===
# 一键启用：分层记忆、角色账本、时间线/因果约束、伏笔债务、重复雷达、视角锁、目标预算、断章钩子规划
SUPER_LONG_MODE_ENABLED=false

# === 自动修订闭环 ===
# 是否启用 Reader 评分不达标时自动修订（默认关闭）
AUTO_REVISION_ENABLED=false
# Reader 评分低于此阈值时触发修订（1-10）
AUTO_REVISION_SCORE_THRESHOLD=6.0
# 最大自动修订轮数（1-5）
AUTO_REVISION_MAX_ROUNDS=2
# 质量地板强制修订开关：为 true 时即使 AUTO_REVISION_ENABLED=false，
# 命中低分/停滞/读者交付缺失仍会触发 writer+editor 重写循环（很费时）。
# 不设置时默认跟随 AUTO_REVISION_ENABLED，两者都关即不再偷跑重写。
# QUALITY_FLOOR_REVISION_ENABLED=false

# === 可选辅助 Agent（关闭可显著提速，默认开启保持质量）===
# 伏笔编排大师（有逾期伏笔时额外调用一次 LLM，45s 独立超时）
# FORESHADOWING_SCHEDULER_ENABLED=true
# 开篇三章总监（仅前 3 章额外调用一次 LLM）
# OPENING_SUPERVISOR_ENABLED=true
# 可读性修复（低分时额外调用一次 editor）；不设置时跟随质量地板修订开关
# READABILITY_REPAIR_ENABLED=false

# === 生成超时兜底 ===
# 单章后台生成空闲超时（毫秒）：只有长时间没有 pipeline 心跳才判定卡死，默认 8 分钟。
# CHAPTER_ROUTE_IDLE_TIMEOUT_MS=480000
# 单章后台生成绝对总时长兜底（毫秒），默认 60 分钟。
# CHAPTER_ROUTE_MAX_TOTAL_TIMEOUT_MS=3600000
# 兼容旧配置名；新部署优先使用 CHAPTER_ROUTE_MAX_TOTAL_TIMEOUT_MS。
# CHAPTER_ROUTE_TIMEOUT_MS=3600000

# ============================================
# 趋势热点大师
# ============================================

# 是否启用趋势分析（true/false）
TRENDS_ENABLED=true

# 搜索引擎提供商
# serpapi / bing / tavily / agent-reach / direct / none
# agent-reach: 使用 Agent Reach 工具（Exa 搜索 + 微博 MCP）
# direct: 直接抓取微博/知乎/百度等热搜
# none: 禁用趋势分析
TRENDS_SEARCH_PROVIDER=none

# 搜索引擎 API Key（agent-reach 模式无需配置）
TRENDS_SEARCH_API_KEY=

# 自定义 API 地址（可选）
TRENDS_SEARCH_API_BASE_URL=

# 定时刷新时间（小时，0-23）
TRENDS_SCHEDULE_HOUR=8

# 定时刷新时间（分钟，0-59）
TRENDS_SCHEDULE_MINUTE=0

# === 定稿后自动梳理 ===
# 是否启用定稿后自动检测梳理建议（默认关闭）
AUTO_CURATE_ENABLED=false

# === Agent 模型覆盖 ===
# JSON 格式，按 Agent 角色指定不同模型供应商（可选）
# 示例：{"writer":{"provider":"anthropic","apiKey":"sk-xxx","model":"claude-3-opus","baseUrl":""}}
AGENT_MODEL_OVERRIDES={}

# === 日志配置 ===
# 日志级别：debug / info / warn / error（默认 info）
LOG_LEVEL=info
# 日志格式：text / json（默认 text，生产环境建议 json）
LOG_FORMAT=text

# === 数据备份 ===
# 删除小说时是否自动备份（默认 true）
BACKUP_AUTO_ON_DELETE=true
# 每部小说最大备份数（默认 10）
BACKUP_MAX_PER_NOVEL=10

# ============================================
# 认证系统配置（可选，默认关闭）
# ============================================

# 是否启用认证系统。
#
# ⚠️ 默认 false 意味着服务完全无鉴权：任何能访问端口的人都可以读写全部小说数据、
#    调用全部接口、消耗你的模型额度。这个默认值只适用于绑定 127.0.0.1 的本地单人使用。
#
#    部署到公网前必须设为 true，并配好 AUTH_JWT_SECRET、AUTH_ADMIN_PASSWORD、
#    USER_API_ENCRYPTION_SECRET、CORS_ORIGINS、SERVER_HOST 和 TRUST_PROXY。
#    详见 SECURITY.md。
AUTH_ENABLED=false

# JWT 密钥（至少32字符，生产环境必须使用强随机密钥）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=

# JWT 过期时间（默认 15m）
AUTH_JWT_EXPIRES_IN=15m

# Refresh Token 过期天数（1-90，默认 7）
AUTH_REFRESH_EXPIRES_DAYS=7

# Redis 配置（用于 refresh token 和速率限制）
AUTH_REDIS_HOST=127.0.0.1
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=
AUTH_REDIS_DB=0

# 管理员账户（生产环境启用认证时必须提供强口令；首次启动时幂等创建）
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=

# 用户 API 密钥加密密钥（启用用户自带 API Key 功能时必须配置，≥32 字符）
# 独立于 JWT 密钥，用于 AES-256-GCM 加密用户存储的 API Key
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
USER_API_ENCRYPTION_SECRET=

# 注册防机器人配置（可选）
# 同一 IP 每小时最大注册次数（默认 5）
# REG_RATE_LIMIT_HOUR_MAX=5
# 同一 IP 每天最大注册次数（默认 10）
# REG_RATE_LIMIT_DAY_MAX=10
# 连续注册失败多少次后自动封禁IP（默认 5）
# IP_BLACKLIST_FAILURE_THRESHOLD=5
# 失败计数的时间窗口，单位分钟（默认 10）
# IP_BLACKLIST_FAILURE_WINDOW_MIN=10
# 自动封禁持续时间，单位分钟（默认 60）
# IP_BLACKLIST_BLOCK_DURATION_MIN=60

# ============================================
# 实名认证配置（可选，默认关闭）
# ============================================

# 是否启用实名认证（默认 false）
# REAL_NAME_ENABLED=false

# 实名认证服务商 HTTP 协议配置
# REAL_NAME_PROVIDER_URL=https://your-real-name-service.com/api/verify
# REAL_NAME_PROVIDER_API_KEY=your_api_key
# REAL_NAME_PROVIDER_TIMEOUT_MS=10000

# 实名认证策略（可选）
# 评论场景：none / optional / required（默认 none）
# REAL_NAME_POLICY_COMMENT=none
# 创作者申请场景：none / optional / required（默认 none）
# REAL_NAME_POLICY_CREATOR_APPLICATION=none
# 书城发布场景：none / optional / required（默认 none）
# REAL_NAME_POLICY_BOOK_PUBLISHING=none
# 充值支付场景：none / optional / required（默认 none）
# REAL_NAME_POLICY_BILLING=none

# ============================================
# SMTP 邮件配置（邀请码申请通知，可选）
# ============================================

# QQ 邮箱示例：SMTP_HOST=smtp.qq.com, SMTP_PORT=465, SMTP_SECURE=true
# SMTP_PASS 填写邮箱授权码（非登录密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 平台访问地址（用于邮件中的注册链接）
PLATFORM_URL=

# ============================================
# 书城内容审核配置（可选，默认关闭）
# ============================================

# 内容审核服务商：tencent / aliyun / baidu
CONTENT_AUDIT_PROVIDER=tencent

# 腾讯云天御配置
CONTENT_AUDIT_API_KEY=
CONTENT_AUDIT_SECRET_KEY=
CONTENT_AUDIT_REGION=ap-guangzhou

# 审核阈值（0-100）
# 置信度 < PASS_THRESHOLD: 自动通过
# PASS_THRESHOLD <= 置信度 < BLOCK_THRESHOLD: 转人工审核
# 置信度 >= BLOCK_THRESHOLD: 自动拒绝
CONTENT_AUDIT_PASS_THRESHOLD=60
CONTENT_AUDIT_BLOCK_THRESHOLD=80

# ===== ToB 独立服务（npm run dev:tob / start:tob，不部署则整段忽略）=====
# 接口调用凭据。留空时 HTTP 与 WebSocket 均无鉴权，仅可用于绑定回环的本机开发；
# NODE_ENV=production 且留空时服务拒绝启动。
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOB_API_TOKEN=

# 监听地址与端口
TOB_HOST=127.0.0.1
TOB_PORT=3310

# CORS 白名单（逗号分隔）。未设置时回退到 CORS_ORIGINS；
# 生产环境两者都为空时服务拒绝启动。
TOB_CORS_ORIGINS=

# 数据目录，默认为 DATA_DIR 下的 tob 子目录
TOB_DATA_DIR=
# 源站小说数据目录，默认自动推断
TOB_SOURCE_DATA_DIR=

# 额外的环境变量文件，默认 .env.tob.local
TOB_ENV_FILE=

# 模型覆盖：留空则沿用主服务的 MODEL_* 配置
TOB_MODEL_PROVIDER=
TOB_MODEL_API_KEY=
TOB_MODEL_NAME=
TOB_MODEL_BASE_URL=

# 任务队列与限流
TOB_WORKER_CONCURRENCY=1
TOB_WORKER_POLL_MS=1200
TOB_RATE_LIMIT_MAX=60

# 是否允许无模型时走桩生成（生产建议关闭）
TOB_ALLOW_MOCK_GENERATION=true
