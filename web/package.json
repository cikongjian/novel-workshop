    "pinia": "2.3.1",
    "qrcode": "1.5.4",
    "vue": "3.5.41",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@csstools/postcss-color-mix-function": "4.0.8",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.4.11",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "postcss-preset-env": "11.4.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.3.0",
    "vue-tsc": "2.2.12"
