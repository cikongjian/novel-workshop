  "scripts": {
    "postinstall": "node -e \"var fs=require('fs');if(fs.existsSync('scripts/patch-element-plus-tabs.mjs')){require('child_process').execSync('node scripts/patch-element-plus-tabs.mjs',{stdio:'inherit'})}\"",
